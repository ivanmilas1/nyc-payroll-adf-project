{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nycpayroll-ivanm"
		},
		"ls_adls_nycpayroll_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_nycpayroll'"
		},
		"LS_SQL_NYCPayroll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_NYCPayroll'"
		},
		"LS_SYNAPSE_NYCPayroll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SYNAPSE_NYCPayroll'"
		},
		"ls_sqldb_nycpayroll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqldb_nycpayroll'"
		},
		"ls_adls_nycpayroll_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsnycpayrollivanm.dfs.core.windows.net/"
		},
		"LS_SQL_NYCPayroll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nycpayroll-ivanm26.database.windows.net"
		},
		"LS_SQL_NYCPayroll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_nycpayroll"
		},
		"LS_SQL_NYCPayroll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "milas"
		},
		"LS_SYNAPSE_NYCPayroll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "synapse-nycpayroll-ivanm-ondemand.sql.azuresynapse.net"
		},
		"LS_SYNAPSE_NYCPayroll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "udacity"
		},
		"LS_SYNAPSE_NYCPayroll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "milas"
		},
		"ls_sqldb_nycpayroll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nycpayroll-ivanm.database.windows.net"
		},
		"ls_sqldb_nycpayroll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_nycpayroll"
		},
		"ls_sqldb_nycpayroll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladminuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-nycpayroll-ivanm_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_nycpayroll_accountKey": {
						"value": "[parameters('ls_adls_nycpayroll_accountKey')]"
					},
					"LS_SQL_NYCPayroll_password": {
						"value": "[parameters('LS_SQL_NYCPayroll_password')]"
					},
					"LS_SYNAPSE_NYCPayroll_password": {
						"value": "[parameters('LS_SYNAPSE_NYCPayroll_password')]"
					},
					"ls_sqldb_nycpayroll_password": {
						"value": "[parameters('ls_sqldb_nycpayroll_password')]"
					},
					"ls_adls_nycpayroll_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_nycpayroll_properties_typeProperties_url')]"
					},
					"LS_SQL_NYCPayroll_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_NYCPayroll_properties_typeProperties_server')]"
					},
					"LS_SQL_NYCPayroll_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_NYCPayroll_properties_typeProperties_database')]"
					},
					"LS_SQL_NYCPayroll_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_NYCPayroll_properties_typeProperties_userName')]"
					},
					"LS_SYNAPSE_NYCPayroll_properties_typeProperties_server": {
						"value": "[parameters('LS_SYNAPSE_NYCPayroll_properties_typeProperties_server')]"
					},
					"LS_SYNAPSE_NYCPayroll_properties_typeProperties_database": {
						"value": "[parameters('LS_SYNAPSE_NYCPayroll_properties_typeProperties_database')]"
					},
					"LS_SYNAPSE_NYCPayroll_properties_typeProperties_userName": {
						"value": "[parameters('LS_SYNAPSE_NYCPayroll_properties_typeProperties_userName')]"
					},
					"ls_sqldb_nycpayroll_properties_typeProperties_server": {
						"value": "[parameters('ls_sqldb_nycpayroll_properties_typeProperties_server')]"
					},
					"ls_sqldb_nycpayroll_properties_typeProperties_database": {
						"value": "[parameters('ls_sqldb_nycpayroll_properties_typeProperties_database')]"
					},
					"ls_sqldb_nycpayroll_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqldb_nycpayroll_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-nycpayroll-ivanm_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-nycpayroll-ivanm_ArmTemplate_0')]"
			]
		}
	]
}